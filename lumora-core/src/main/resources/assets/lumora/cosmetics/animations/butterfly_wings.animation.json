{
	"format_version": "1.8.0",
	"animations": {
		"animation.lumora.butterfly_wings.idle": {
			"loop": true,
			"animation_length": 4,
			"bones": {
				"wing_left": {
					"rotation": [0, "-math.sin(query.anim_time * 90) * 10.0", "-math.sin(query.anim_time * 90) * 3"]
				},
				"wing_right": {
					"rotation": [0, "math.sin(query.anim_time * 90) * 10.0", "math.sin(query.anim_time * 90) * 3"]
				}
			}
		},
		"animation.lumora.butterfly_wings.walk": {
			"loop": true,
			"animation_length": 1,
			"bones": {
				"wing_left": {
					"rotation": [0, "-8 - math.sin(query.anim_time * 360) * 13.0", "-math.sin(query.anim_time * 360) * 4"]
				},
				"wing_right": {
					"rotation": [0, "8 + math.sin(query.anim_time * 360) * 13.0", "math.sin(query.anim_time * 360) * 4"]
				}
			}
		},
		"animation.lumora.butterfly_wings.flap": {
			"loop": true,
			"animation_length": 0.5,
			"bones": {
				"wing_left": {
					"rotation": [0, 15, "math.sin(query.anim_time * 720) * 34.0"]
				},
				"wing_right": {
					"rotation": [0, -15, "-math.sin(query.anim_time * 720) * 34.0"]
				}
			}
		},
		"animation.lumora.butterfly_wings.glide": {
			"loop": true,
			"animation_length": 2,
			"bones": {
				"wing_left": {
					"rotation": [0, 18.0, "14 + math.sin(query.anim_time * 180) * 3"]
				},
				"wing_right": {
					"rotation": [0, -18.0, "-14 - math.sin(query.anim_time * 180) * 3"]
				}
			}
		},
		"animation.lumora.butterfly_wings.fold": {
			"loop": true,
			"animation_length": 1,
			"bones": {
				"wing_left": {
					"rotation": [0, -30, 14]
				},
				"wing_right": {
					"rotation": [0, 30, -14]
				}
			}
		}
	}
}
